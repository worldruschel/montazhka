# Провайдер озвучки (TTS): edge | openrouter | aitunnel | elevenlabs | openai
# По умолчанию включён бесплатный edge (работает сразу без API-ключей)
TTS_PROVIDER=edge

# --- Бесплатный вариант (0 ₽, без ключей) ---
# Edge TTS (женский: ru-RU-SvetlanaNeural — стабильнее; мужской: ru-RU-DmitryNeural)
EDGE_TTS_VOICE=ru-RU-SvetlanaNeural
EDGE_TTS_RATE=+0%

# --- Премиум через OpenRouter (нужен VPN, оплата зарубежной картой или криптой) ---
# Регистрация: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=elevenlabs/eleven-v4
OPENROUTER_TTS_VOICE=ogi2DyUAKJb7CEdqqvlU

# --- Премиум через AI Tunnel (без VPN, оплата в рублях) ---
# Регистрация: https://aitunnel.ru
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
AITUNNEL_TTS_MODEL=gpt-4o-mini-tts
AITUNNEL_TTS_VOICE=alloy

# --- Прямой ElevenLabs (если уже есть аккаунт) ---
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=

# --- Прямой OpenAI (если уже есть аккаунт) ---
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Пословное выравнивание (STT): auto | faster-whisper | openai | proportional
STT_PROVIDER=auto
WHISPER_MODEL=small
WHISPER_LANGUAGE=ru
